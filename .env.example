# 복사해서 사용한다: cp .env.example .env.local  (.env, .env.*는 커밋되지 않는다)
# 비밀 값은 넣지 않는다. VITE_ 변수는 빌드 결과(브라우저)에 그대로 노출된다

# true면 실제 백엔드 API 모드, 그 외에는 Mock 모드
VITE_USE_API=false
# API 요청 앞에 붙는 주소. 비워 두면 같은 출처(/api/**)로 요청한다
VITE_API_BASE_URL=
# 개발 서버가 /api를 프록시할 Spring 서버 주소
VITE_BACKEND_TARGET=http://localhost:8080
# 시청자 화면·로그인 배경 영상과 포스터. 비워 두면 public/media의 기본 파일을 쓴다
VITE_STREAM_SRC=
VITE_STREAM_POSTER=
